{
  "manifest_version": 3,
  "name": "Popup Window — Clean Tab Pop-out",
  "version": "0.1.0",
  "description": "Move the current tab into a minimal popup window, or open a link in one.",
  "minimum_chrome_version": "102",
  "permissions": [
    "contextMenus",
    "storage"
  ],
  "background": {
    "service_worker": "src/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Pop out / restore this tab",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-current-tab": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Pop out or restore the current tab"
    }
  }
}
