{
  "manifest_version": 3,
  "name": "Popup Window — Clean Tab Pop-out",
  "version": "0.2.0",
  "description": "Open the current page in an always-on-top floating view, with regular popup-window controls as an alternative.",
  "minimum_chrome_version": "102",
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "src/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open / close always-on-top view",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-current-tab": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Open or close the current page's floating PiP view"
    }
  }
}
